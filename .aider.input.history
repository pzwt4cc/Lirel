+Исправь ошибку компиляции в src/ui.rs: метод `ui.combo` не существует в egui. Используй стандартный ComboBox для выбора формата:
+
+egui::ComboBox::from_label("Формат")
+    .selected_text(format!("{:?}", self.output_format))
+    .show_ui(ui, |ui| {
+        ui.selectable_value(&mut self.output_format, OutputFormat::Mp3, "MP3");
+        ui.selectable_value(&mut self.output_format, OutputFormat::Wav, "WAV");
+        ui.selectable_value(&mut self.output_format, OutputFormat::Flac, "FLAC");
+        ui.selectable_value(&mut self.output_format, OutputFormat::Ogg, "OGG");
+        ui.selectable_value(&mut self.output_format, OutputFormat::Aac, "AAC");
+    });

